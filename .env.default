# This file should be safe to commit and can act as documentation for all
# the possible configurations of our server.

# This file contains the default environment variables, by default,
# it is third in precedence:
#   1. process environment variables
#   2. `.env` file contents
#   3. `.env.default` file contents.
ENV=dev
HTTP_SERVER_PORT=3000
HTTP_SERVER_HOST=0.0.0.0

PG_COMPONENT_PSQL_PORT='5450'
PG_COMPONENT_PSQL_HOST='localhost'
PG_COMPONENT_PSQL_DATABASE='comms_gatekeeper'
PG_COMPONENT_PSQL_USER='postgres'
PG_COMPONENT_PSQL_PASSWORD='pass1234'

LOG_LEVEL=OFF

# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false

SERVICE_BASE_URL='https://comms-gatekeeper.decentraland.zone'
WORLD_CONTENT_URL=https://worlds-content-server.decentraland.org
CATALYST_CONTENT_URL=https://peer.decentraland.org/content
PLACES_API_URL=https://places.decentraland.org/api
DENYLIST_JSON_URL=https://config.decentraland.org/denylist.json
SOCIAL_SERVICE_URL=https://social-service-ea.decentraland.org
# Secret: must be provided by the deployment environment. Left unset on purpose so
# config.requireString('COMMS_GATEKEEPER_AUTH_TOKEN') fails fast instead of silently
# falling back to a committed placeholder that would ship in the image.
# COMMS_GATEKEEPER_AUTH_TOKEN=
# LiveKit room-name prefixes. Keep the world defaults aligned with worlds-content-server, which
# builds the same names from COMMS_ROOM_PREFIX ('world-') and SCENE_ROOM_PREFIX
# ('world-scene-room-'). Production overrides both services' values.
#
# COMMS_ROOM_PREFIX  -> the world room ({prefix}{worldName}), the content server's COMMS_ROOM_PREFIX
# WORLD_ROOM_PREFIX  -> the world scene room ({prefix}{worldName}-{sceneId}), the content
#                       server's SCENE_ROOM_PREFIX
# SCENE_ROOM_PREFIX  -> the Genesis City scene room ({prefix}{realmName}:{sceneId}); the content
#                       server has no counterpart, it serves worlds only
COMMS_ROOM_PREFIX=world-
WORLD_ROOM_PREFIX=world-scene-room-
SCENE_ROOM_PREFIX=
PRIVATE_MESSAGES_ROOM_ID=private-messages
PROD_LIVEKIT_HOST=
PROD_LIVEKIT_API_KEY=
PROD_LIVEKIT_API_SECRET=
PREVIEW_LIVEKIT_HOST=
PREVIEW_LIVEKIT_API_KEY=
PREVIEW_LIVEKIT_API_SECRET=
LAMBDAS_URL=https://peer.decentraland.zone/lambdas
AWS_SNS_ARN=
AWS_SNS_ENDPOINT=
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_TOKEN=

# Voice chat connection interrupted TTL in MS
VOICE_CHAT_CONNECTION_INTERRUPTED_TTL=300000
# Voice chat initial connection TTL in MS
VOICE_CHAT_INITIAL_CONNECTION_TTL=300000
# Community voice chat no moderator present in room TTL in MS
COMMUNITY_VOICE_CHAT_NO_MODERATOR_TTL=300000

VOICE_CHAT_EXPIRED_BATCH_SIZE=50
ANALYTICS_CONTEXT="comms-gatekeeper"
ANALYTICS_API_URL=""
ANALYTICS_API_TOKEN=""

CAST2_URL=https://decentraland.org/cast

# Enable local preview support — when true, LocalPreview scenes get:
# - Admin check bypassed for stream link generation
# - All users granted 'presenter' role for presentation control
# - Synthetic place IDs (no Places API dependency)
# - Production LiveKit settings (not empty preview settings)
# Set to 'true' for local development, leave empty for production
ALLOW_LOCAL_PREVIEW=

# Authoritative Server Public Address to validate signed-fetch
AUTHORITATIVE_SERVER_ADDRESS=

# Token for moderator authentication (alternative to wallet signature)
MODERATOR_TOKEN=

# --- Cluster subscriber (Archipelago => Pulse migration, iteration 1) ---
# Cutover switch. Set to 'true' to subscribe to Pulse's cluster feed and mint LiveKit
# tokens for island rooms. Unset means off, and off is byte-identical to the previous
# behaviour: no connection is attempted.
CLUSTER_SUBSCRIBER_ENABLED=

# NATS broker URL, comma-separated for a seed list. Same secret name as the archipelago
# services, so one injected value serves both. When set, it always starts the presence map and
# requires PULSE_URL, independently of CLUSTER_SUBSCRIBER_ENABLED. When unset, the cluster
# subscriber stays off and both presence routes answer 503 warming.
NATS_URL=

# Queue group for peer.*.cluster_change, so exactly one replica handles each event instead
# of every replica minting and publishing for all of them.
NATS_QUEUE_GROUP=comms-gatekeeper-cluster

# Per-wallet assignment state. Only consumer is fromIslandId. TTL is the only reclamation
# mechanism, because the feed carries no disconnect event.
CLUSTER_PEER_STATE_TTL_MS=3600000
CLUSTER_PEER_STATE_MAX=20000

# Ban-result cache TTL. Bounds staleness in both directions; a fresh ban also removes the
# participant from every live room, so this only delays re-issuance.
CLUSTER_BAN_CACHE_TTL_MS=30000

# Base delay between the three attempts to remove a displaced session from its room.
CLUSTER_TAKEOVER_RETRY_DELAY_MS=100

# --- Presence map, /hot-scenes and /scene-participants (Pulse migration, iteration 2) ---
# NATS_URL makes every replica subscribe to Pulse's engine.parcel_changes and keep the map of
# where every online peer stands. There is no configurable presence source or LiveKit fallback.

# Pulse's base URL. Used once on boot, for GET {PULSE_URL}/peers?all=true, so the routes can
# answer before the first snapshot arrives on the feed instead of 503-ing for up to a minute.
#
# Required whenever NATS_URL is set: an absent value, or anything that is not an absolute http(s)
# URL, fails the boot. Without NATS_URL a local run remains valid and both presence routes answer
# 503 warming.
#
# Deliberately left commented out rather than shipped empty: this file is a live config source
# inside the image (src/components.ts loads ['.env.default', '.env']), and a bare `PULSE_URL=`
# line resolves to the empty string, which getString returns and requireString accepts - a key
# that can never be missing and can never be required. Commented out, an unset one is genuinely
# unset, which is what makes the boot check above possible.
# PULSE_URL=

# How long an entry that only the boot-time prime stands behind is trusted for. The prime is the
# all-instances list from GET {PULSE_URL}/peers?all=true and carries no server_name, so no
# publisher's snapshot owns those entries and nothing else can retire them. The default is Pulse's
# 60 s snapshot interval plus margin: every publisher that is alive re-asserts its own peers well
# inside it, and whatever is left after that is a peer who left during the hand-over. Readiness
# expires with it too — a prime no feed ever took over from stops answering for the world rather
# than reporting it empty.
PRESENCE_PRIME_TTL_MS=90000

# How long a Pulse instance may publish nothing before it is presumed gone, at which point every
# entry it owns is dropped and its seq forgotten (it comes back through its next snapshot, like
# any publisher's first batch). Pulse guarantees a snapshot every 60 s, so the default is 2.5
# intervals of silence: a scaled-down or replaced replica, not a merely quiet one. Without it the
# peers of a retired replica would be counted as online for the life of this process.
PRESENCE_SERVER_TTL_MS=150000

# How often /hot-scenes recomputes its ranking. The join needs catalyst metadata for every
# occupied tile of Genesis City, so it is precomputed on this timer rather than per request.
HOT_SCENES_REFRESH_MS=10000

# How long a tile's resolved scene (or its absence) is cached for. Most of the city is empty and
# re-asking the catalyst about empty tiles every refresh is where the cost would be.
HOT_SCENES_SCENE_TTL_MS=300000
